{
  "name": "lm-backlog",
  "displayName": "Backlog",
  "description": "Create tasks and attach relevant files to them",
  "version": "1.0.0",
  "publisher": "lulasz",
  "repository": {
    "type": "git",
    "url": "https://github.com/lulasz/lm-backlog-extension.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**"
  ],
  "main": "./out/extension.js",
  "icon": "icon.png",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "backlog",
          "name": "Backlog",
          "icon": "$(tasklist)",
          "contextualTitle": "Backlog"
        }
      ]
    },
    "commands": [
      {
        "command": "backlog.addTask",
        "title": "New Task",
        "icon": "$(add)"
      },
      {
        "command": "backlog.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "backlog.editTask",
        "title": "Edit",
        "icon": "$(edit)"
      },
      {
        "command": "backlog.deleteTask",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "backlog.toggleComplete",
        "title": "Toggle Complete",
        "icon": "$(circle-slash)"
      },
      {
        "command": "backlog.addFile",
        "title": "Add File to Task"
      },
      {
        "command": "backlog.addAllOpenFiles",
        "title": "Add All Open Files to Task"
      },
      {
        "command": "backlog.openAllTaskFiles",
        "title": "Open All Task Files"
      },
      {
        "command": "backlog.removeFile",
        "title": "Remove from Task",
        "icon": "$(remove)"
      },
      {
        "command": "backlog.addFileToTask",
        "title": "Add to Backlog Task"
      },
      {
        "command": "backlog.quickAddFileToTask",
        "title": "Add Current File to Task",
        "icon": "$(link)"
      }
    ],
    "configuration": {
      "title": "Backlog Config",
      "properties": {
        "backlog.filename": {
          "type": "string",
          "default": "backlog.json",
          "description": "The name of the JSON file used to store the backlog data. Stored in the .vscode folder."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "backlog.addTask",
          "when": "view == backlog",
          "group": "navigation@1"
        },
        {
          "command": "backlog.refresh",
          "when": "view == backlog",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "backlog.editTask",
          "when": "view == backlog && viewItem == task",
          "group": "3_manage@1"
        },
        {
          "command": "backlog.deleteTask",
          "when": "view == backlog && viewItem == task",
          "group": "3_manage@2"
        },
        {
          "command": "backlog.toggleComplete",
          "when": "view == backlog && viewItem == task",
          "group": "2_completion@1"
        },
        {
          "command": "backlog.addFile",
          "when": "view == backlog && viewItem == task",
          "group": "1_add@1"
        },
        {
          "command": "backlog.addAllOpenFiles",
          "when": "view == backlog && viewItem == task",
          "group": "1_add@2"
        },
        {
          "command": "backlog.openAllTaskFiles",
          "when": "view == backlog && viewItem == task",
          "group": "4_open@1"
        },
        {
          "command": "backlog.removeFile",
          "when": "view == backlog && viewItem == taskFile",
          "group": "inline@1"
        }
      ],
      "explorer/context": [
        {
          "command": "backlog.addFileToTask",
          "when": "!explorerResourceIsFolder",
          "group": "7_modification@99"
        }
      ],
      "editor/title": [
        {
          "command": "backlog.quickAddFileToTask",
          "when": "resourceScheme == file",
          "group": "navigation@99"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npm run compile && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.3.0"
  }
}
